# Server Configuration
PORT=8080
TOKEN_DURATION=24h
PROFILES_FOLDER=./profiles

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dashboard?sslmode=disable

# Security - 32 character PASETO token key (exactly 32 characters/bytes)
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012

# Cloudinary Configuration (For image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
